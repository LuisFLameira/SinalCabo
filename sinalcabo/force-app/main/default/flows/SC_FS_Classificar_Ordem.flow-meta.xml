    <description>Acção Classificar da ordem de trabalho. Mostra o resumo da NOS e a proposta da API, deixa o despachante confirmar ou escolher outra célula, e grava célula, tecnologia, território, confirmação, origem e divergência de território. O território da célula é a zona da NOS, um território filho, por isso o ecrã mostra a zona e o pai, e a divergência compara o pai da zona com o território do grupo que a NOS atribuiu.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCodigo_sugerido</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!Obter_a_ordem.Celulas_Candidatas__c}) &gt; 0, {!Obter_a_ordem.Celulas_Candidatas__c}, &quot;indicada no resumo&quot;)</expression>
    </formulas>
    <formulas>
        <name>fDivergencia</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!Obter_a_celula_escolhida.Territorio__c})),
  NOT(ISBLANK({!Obter_o_territorio_do_grupo.Id})),
  IF(
    ISBLANK({!Obter_a_celula_escolhida.Territorio__r.ParentTerritoryId}),
    {!Obter_a_celula_escolhida.Territorio__c} &amp; &quot;&quot;,
    {!Obter_a_celula_escolhida.Territorio__r.ParentTerritoryId} &amp; &quot;&quot;
  ) &lt;&gt; ({!Obter_o_territorio_do_grupo.Id} &amp; &quot;&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>fOrigem_mantida</name>
        <dataType>String</dataType>
        <expression>IF(LEN(TEXT({!Obter_a_ordem.Origem_Celula__c})) = 0, &quot;Despacho&quot;, TEXT({!Obter_a_ordem.Origem_Celula__c}))</expression>
    </formulas>
    <formulas>
        <name>fRuas_actual</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!Obter_a_celula_actual.Ruas_Conhecidas__c}) = 0, &quot;sem ruas registadas&quot;, IF(LEN({!Obter_a_celula_actual.Ruas_Conhecidas__c}) &gt; 600, LEFT({!Obter_a_celula_actual.Ruas_Conhecidas__c}, 600) &amp; &quot; (lista truncada, abra a célula para a ver toda)&quot;, {!Obter_a_celula_actual.Ruas_Conhecidas__c}))</expression>
    </formulas>
    <formulas>
        <name>fRuas_escolhida</name>
        <dataType>String</dataType>
        <expression>IF(LEN({!Obter_a_celula_escolhida.Ruas_Conhecidas__c}) = 0, &quot;sem ruas registadas&quot;, IF(LEN({!Obter_a_celula_escolhida.Ruas_Conhecidas__c}) &gt; 600, LEFT({!Obter_a_celula_escolhida.Ruas_Conhecidas__c}, 600) &amp; &quot; (lista truncada, abra a célula para a ver toda)&quot;, {!Obter_a_celula_escolhida.Ruas_Conhecidas__c}))</expression>
    </formulas>
    <formulas>
        <name>fTerritorioProposto</name>
        <dataType>String</dataType>
        <expression>IF(
  LEN({!Obter_a_ordem.ServiceTerritory.Name}) = 0,
  &quot;sem território&quot;,
  IF(
    LEN({!Obter_a_ordem.ServiceTerritory.ParentTerritory.Name}) = 0,
    {!Obter_a_ordem.ServiceTerritory.Name},
    {!Obter_a_ordem.ServiceTerritory.Name} &amp; &quot;, &quot; &amp; {!Obter_a_ordem.ServiceTerritory.ParentTerritory.Name}
  )
)</expression>
    </formulas>
    <formulas>
        <name>fZonaEscolhida</name>
        <dataType>String</dataType>
        <expression>IF(
  LEN({!Obter_a_celula_escolhida.Territorio__r.ParentTerritory.Name}) = 0,
  {!Obter_a_celula_escolhida.Territorio__r.Name},
  {!Obter_a_celula_escolhida.Territorio__r.Name} &amp; &quot;, &quot; &amp; {!Obter_a_celula_escolhida.Territorio__r.ParentTerritory.Name}
)</expression>
    </formulas>
    <formulas>
        <name>fZonaProposta</name>
        <dataType>String</dataType>
        <expression>IF(
  LEN({!Obter_a_celula_actual.Territorio__r.ParentTerritory.Name}) = 0,
  {!Obter_a_celula_actual.Territorio__r.Name},
  {!Obter_a_celula_actual.Territorio__r.Name} &amp; &quot;, &quot; &amp; {!Obter_a_celula_actual.Territorio__r.ParentTerritory.Name}
)</expression>
    </formulas>
