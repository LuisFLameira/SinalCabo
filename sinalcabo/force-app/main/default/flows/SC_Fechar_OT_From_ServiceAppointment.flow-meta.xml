    <decisions>
        <name>Decision_AlreadyCompleted</name>
        <label>Already completed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Confirmar</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Can close</defaultConnectorLabel>
        <rules>
            <name>CompletedAlready</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recServiceAppointment.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recServiceAppointment.ActualEndTime</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_AlreadyCompleted</targetReference>
            </connector>
            <label>Already completed</label>
        </rules>
    </decisions>
