        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opps_Renovacao</name>
        <label>Get Opps Renovacao</label>
        <locationX>176</locationX>
        <locationY>160</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_F5</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND 4 AND 5</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </filters>
        <filters>
            <field>Data_Inicio_Contrato__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Data_Fim_Contrato__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Data_Fim_Contrato__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>formulaToday</elementReference>
            </value>
        </filters>
        <filters>
            <field>Data_Fim_Contrato__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>formulaTectoFim</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputReference>var_cwOpps</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>Data_Inicio_Contrato__c</queriedFields>
        <queriedFields>Data_Fim_Contrato__c</queriedFields>
        <queriedFields>Data_Alerta_Renovacao_Enviado__c</queriedFields>
        <queriedFields>Numero_Contrato__c</queriedFields>
        <queriedFields>Amount</queriedFields>
        <queriedFields>Empresa_Lider__c</queriedFields>
    </recordLookups>
