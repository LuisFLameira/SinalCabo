    <decisions>
        <name>Check_Janela_Disparo</name>
        <label>Atingiu a data de disparo e ainda nao alertou?</label>
        <locationX>176</locationX>
        <locationY>340</locationY>
        <defaultConnector>
            <targetReference>Loop_F5</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Nao disparar</defaultConnectorLabel>
        <rules>
            <name>Disparar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaDeveDisparar</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reset_Recipients</targetReference>
            </connector>
            <label>Disparar renovacao</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_Houve_Falhas</name>
        <label>Houve falhas no ciclo?</label>
        <locationX>176</locationX>
        <locationY>1060</locationY>
        <defaultConnectorLabel>Correu tudo bem</defaultConnectorLabel>
        <rules>
            <name>Houve_Falhas</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFalhasTexto</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varFalhasTexto</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Registar_Falha</targetReference>
            </connector>
            <label>Houve falhas</label>
        </rules>
    </decisions>
    <description>Scheduled Flow diario. Regra de disparo (PVD): alerta no mais cedo entre (Data_Inicio + 0,6667 x duracao) e (Data_Fim - 6 meses); duracao calculada das datas. Dedup por Data_Alerta_Renovacao_Enviado__c: alerta uma vez e volta a alertar se a data de disparo avancar (renovacao futura). Por cada Closed Won elegivel cria Task e envia Custom Notification in-app ao owner (sem email; canal independente do dominio I.3).</description>
    <environments>Default</environments>
    <formulas>
        <name>forFalhaTask</name>
        <dataType>String</dataType>
        <expression>&quot;Create_Task_Renovacao falhou na oportunidade &quot; &amp; {!Loop_F5.Id} &amp; &quot;: &quot; &amp; {!$Flow.FaultMessage} &amp; &quot; | &quot;</expression>
    </formulas>
    <formulas>
        <name>forFaultMsg</name>
        <dataType>String</dataType>
        <expression>&quot;Update_Opps_Controlo falhou: &quot; &amp; {!$Flow.FaultMessage} &amp; &quot; | &quot;</expression>
    </formulas>
    <formulas>
        <name>formulaDataDisparo</name>
        <dataType>Date</dataType>
        <expression>IF({!formulaMarco67} &lt; {!formulaMarco6Meses}, {!formulaMarco67}, {!formulaMarco6Meses})</expression>
    </formulas>
    <formulas>
        <name>formulaDeveDisparar</name>
        <dataType>Boolean</dataType>
        <expression>{!formulaDataDisparo} &lt;= TODAY() &amp;&amp; (ISBLANK({!Loop_F5.Data_Alerta_Renovacao_Enviado__c}) || {!Loop_F5.Data_Alerta_Renovacao_Enviado__c} &lt; {!formulaDataDisparo})</expression>
    </formulas>
    <formulas>
        <name>formulaMarco67</name>
        <dataType>Date</dataType>
        <expression>{!Loop_F5.Data_Inicio_Contrato__c} + ROUND(0.6667 * ({!Loop_F5.Data_Fim_Contrato__c} - {!Loop_F5.Data_Inicio_Contrato__c}), 0)</expression>
    </formulas>
    <formulas>
        <name>formulaMarco6Meses</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!Loop_F5.Data_Fim_Contrato__c}, -6)</expression>
    </formulas>
    <formulas>
        <name>formulaNotifBody</name>
        <dataType>String</dataType>
        <expression>&quot;Contrato a renovar: &quot; &amp; {!Loop_F5.Name} &amp; &quot; (fim &quot; &amp; TEXT({!Loop_F5.Data_Fim_Contrato__c}) &amp; &quot;)&quot;</expression>
    </formulas>
    <formulas>
        <name>formulaTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Renovacao de Contrato: &quot; &amp; {!Loop_F5.Name}</expression>
    </formulas>
    <formulas>
        <name>formulaTectoFim</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 365</expression>
    </formulas>
    <formulas>
        <name>formulaToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>SC Alerta Renovacao {!$Flow.CurrentDateTime}</interviewLabel>
