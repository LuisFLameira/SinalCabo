        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>origem</name>
            <value>
                <stringValue>SC_Recalcular_Segmento_Todas</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>elemento</name>
