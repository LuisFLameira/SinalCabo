<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Adjudicacao</name>
        <label>Carimbar Data Adjudicacao</label>
        <locationX>440</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.Data_Adjudicacao__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Entregue</name>
        <label>Carimbar Data Proposta Entregue</label>
        <locationX>200</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>$Record.Data_Proposta_Entregue__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Qual_Transicao</name>
        <label>Qual transicao</label>
        <locationX>320</locationX>
        <locationY>230</locationY>
        <defaultConnectorLabel>Outro</defaultConnectorLabel>
        <rules>
            <name>Entrou_Proposta_Enviada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposta Enviada</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Data_Proposta_Entregue__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Entregue</targetReference>
            </connector>
            <label>Entrou em Proposta Enviada</label>
        </rules>
        <rules>
            <name>Entrou_Adjudicada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Adjudicada</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Data_Adjudicacao__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Adjudicacao</targetReference>
            </connector>
            <label>Entrou em Adjudicada</label>
        </rules>
    </decisions>
    <description>SinalCabo (Fase 4). Before-save: carimba Data_Proposta_Entregue ao entrar em Proposta Enviada e Data_Adjudicacao ao entrar em Adjudicada, so se ainda estiverem vazias. Da datas de evento fiaveis para os reports de contagem por mes.</description>
    <environments>Default</environments>
    <interviewLabel>SC Carimbo Datas Evento {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SC - Carimbo Datas Evento</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>320</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Qual_Transicao</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Proposta Enviada</stringValue>
            </value>
        </filters>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Adjudicada</stringValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
