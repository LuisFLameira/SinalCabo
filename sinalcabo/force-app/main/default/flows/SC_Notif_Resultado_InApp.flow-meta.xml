<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Aprovada</name>
        <label>Notificar owner, aprovada</label>
        <locationX>50</locationX>
        <locationY>480</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_CNT.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Proposta aprovada</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>formulaAprovada</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>varRecipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Send_Recusada</name>
        <label>Notificar owner, recusada</label>
        <locationX>300</locationX>
        <locationY>480</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_CNT.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Proposta recusada</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>formulaRecusada</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>varRecipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Owner</name>
        <label>Adicionar owner aos destinatarios</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>varRecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decision_Resultado</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Resultado</name>
        <label>Aprovada ou Recusada?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Outro</defaultConnectorLabel>
        <rules>
            <name>out_Aprovada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposta Enviada</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Aprovada</targetReference>
            </connector>
            <label>Aprovada</label>
        </rules>
        <rules>
            <name>out_Recusada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Em Elaboração</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Recusada</targetReference>
            </connector>
            <label>Recusada</label>
        </rules>
    </decisions>
    <description>ADITIVO e independente dos thresholds. Record-Triggered AfterSave na Opportunity: quando o StageName transita A PARTIR DE &quot;Aprovação Interna&quot; para &quot;Proposta Enviada&quot; (aprovada) ou &quot;Em Elaboração&quot; (recusada), envia Custom Notification in-app (sino + push) ao Owner com o resultado e link para a opp. NAO dispara quando o Approval_Status ficou em &quot;Recolhido&quot;: nesse caso a opp voltou a &quot;Em Elaboração&quot; por recall do submissor e nao por recusa, e quem e notificado e o aprovador, pelo SC_Notif_Recall_InApp. Nao toca no SC_Trigger_Aprovacao_G2, CMT, email nem nos thresholds.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaAprovada</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; &quot; foi aprovada e avançou para Proposta Enviada.&quot;</expression>
    </formulas>
    <formulas>
        <name>formulaRecusada</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; &quot; foi recusada e voltou a Em Elaboração.&quot;</expression>
    </formulas>
    <interviewLabel>SC Notif Resultado InApp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SC - Notif Resultado InApp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_CNT</name>
        <label>Get Custom Notification Type</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Add_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aprovacao_Resultado</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>DeveloperName</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CNT</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.StageName}) &amp;&amp; ISPICKVAL(PRIORVALUE({!$Record.StageName}), &quot;Aprovação Interna&quot;) &amp;&amp; NOT(ISPICKVAL({!$Record.Approval_Status__c}, &quot;Recolhido&quot;))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varRecipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
