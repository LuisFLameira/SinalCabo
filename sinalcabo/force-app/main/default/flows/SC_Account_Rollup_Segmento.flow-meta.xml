    <description>F7 — Recalcula rollups de Closed Won na Account e actualiza os dois segmentos. Dispara AfterSave na Opportunity. A base de calculo do segmento e&apos; a JANELA DOS ULTIMOS 12 MESES COMPLETOS, a excluir o mes corrente, e os escaloes vem do Custom Metadata SC_Segmento_Escalao, nao estao fixos no flow. Alterar um escalao e&apos; editar um registo, sem deploy. Conta a zero continua SEM segmento; o Bronze comeca acima de zero.</description>
    <formulas>
        <name>forAnoAnterior</name>
        <dataType>Boolean</dataType>
        <expression>YEAR({!Loop_Opps.CloseDate}) = (YEAR(TODAY()) - 1)</expression>
    </formulas>
    <formulas>
        <name>forAnoCorrente</name>
        <dataType>Boolean</dataType>
        <expression>YEAR({!Loop_Opps.CloseDate}) = YEAR(TODAY())</expression>
    </formulas>
    <formulas>
        <name>forFaultMsg</name>
        <dataType>String</dataType>
        <expression>&quot;SC_Account_Rollup_Segmento falhou para AccountId &quot; &amp; {!$Record.AccountId} &amp; &quot; | &quot; &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>forMargemOpp</name>
        <dataType>Currency</dataType>
        <expression>{!Loop_Opps.Amount} - BLANKVALUE({!Loop_Opps.Custo_Estimado__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>forNaJanela</name>
        <dataType>Boolean</dataType>
        <expression>{!Loop_Opps.CloseDate} &gt;= ADDMONTHS(DATE(YEAR(TODAY()), MONTH(TODAY()), 1), -12) &amp;&amp; {!Loop_Opps.CloseDate} &lt; DATE(YEAR(TODAY()), MONTH(TODAY()), 1)</expression>
    </formulas>
    <label>SC Account Rollup e Segmento</label>
