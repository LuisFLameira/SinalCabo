<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Notificacao</name>
        <label>Enviar notificacao in-app ao N3</label>
        <locationX>176</locationX>
        <locationY>528</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_CNT.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Aprovacao final pendente (L3)</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>formulaBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>varRecipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Recipient</name>
        <label>Adicionar N3 aos destinatarios</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <assignmentItems>
            <assignToReference>varRecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Aprovador_Alvo_N3__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Notificacao</targetReference>
        </connector>
    </assignments>
    <description>ADITIVO (Fase B, 3o nivel). Quando Approval_Status__c muda para &quot;Aguarda L3&quot;, envia uma Custom Notification in-app (sino + push movel) ao aprovador N3 (Aprovador_Alvo_N3__c, resolvido pela matriz), com nome e valor da oportunidade e link para o registo. GUARDA DE NIVEL FANTASMA no start: so dispara se Requer_N3__c=true E Aprovador_Alvo_N3__c preenchido, para nao notificar num &quot;Aguarda L3&quot; transitorio de uma opp de 2 niveis. Id do Custom Notification Type por DeveloperName (Aprovacao_Pendente), sem hardcode.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaBody</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; &quot; — &quot; &amp; TEXT({!$Record.Amount}) &amp; &quot; EUR&quot;</expression>
    </formulas>
    <interviewLabel>SC Notif Aprovacao L3 InApp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SC - Notif Aprovacao L3 InApp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_CNT</name>
        <label>Get Custom Notification Type</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Add_Recipient</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aprovacao_Pendente</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>DeveloperName</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CNT</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>ISPICKVAL({!$Record.Approval_Status__c}, &quot;Aguarda L3&quot;) &amp;&amp; {!$Record.Requer_N3__c} &amp;&amp; NOT(ISBLANK({!$Record.Aprovador_Alvo_N3__c}))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varRecipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
