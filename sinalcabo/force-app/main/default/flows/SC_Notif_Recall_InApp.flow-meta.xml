<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Recall</name>
        <label>Notificar aprovador, pedido retirado</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_CNT.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Pedido de aprovação retirado</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>formulaBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>varRecipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_N1</name>
        <label>Adicionar aprovador N1 aos destinatarios</label>
        <locationX>50</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>varRecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Aprovador_Alvo_N1__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Recall</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_N2</name>
        <label>Adicionar aprovador N2 aos destinatarios</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>varRecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Aprovador_Alvo_N2__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Recall</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_N3</name>
        <label>Adicionar aprovador N3 aos destinatarios</label>
        <locationX>300</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>varRecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Aprovador_Alvo_N3__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Recall</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Nivel_Pendente</name>
        <label>Que nivel estava pendente?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>Nivel nao identificado, terminar sem notificar</defaultConnectorLabel>
        <rules>
            <name>out_N1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaNivelPendente</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>N1</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Aprovador_Alvo_N1__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_N1</targetReference>
            </connector>
            <label>Pendente em N1</label>
        </rules>
        <rules>
            <name>out_N2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaNivelPendente</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>N2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Aprovador_Alvo_N2__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_N2</targetReference>
            </connector>
            <label>Pendente em N2</label>
        </rules>
        <rules>
            <name>out_N3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaNivelPendente</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>N3</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Aprovador_Alvo_N3__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_N3</targetReference>
            </connector>
            <label>Pendente em N3</label>
        </rules>
    </decisions>
    <description>ADITIVO. Record-Triggered AfterSave na Opportunity: quando Approval_Status__c passa a &quot;Recolhido&quot; (o submissor retirou o pedido pelo Recall nativo), avisa o aprovador que tinha o pedido em mao que ele deixou de estar pendente. O nivel pendente e lido do valor anterior de Approval_Status__c (Aguarda L1/L2/L3), e o destinatario e o Aprovador_Alvo desse nivel, que o recall nao limpa. Reutiliza o Custom Notification Type Aprovacao_Pendente, resolvido por DeveloperName, porque a mensagem e sobre a fila de aprovacao do proprio. Se o nivel nao for identificavel ou o aprovador estiver vazio, termina sem notificar. O dono da oportunidade nao e notificado aqui: foi ele que retirou o pedido.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaBody</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; &quot; deixou de estar pendente da tua aprovação: o pedido foi retirado por &quot; &amp; {!$User.FirstName} &amp; &quot; &quot; &amp; {!$User.LastName} &amp; &quot;.&quot;</expression>
    </formulas>
    <formulas>
        <name>formulaNivelPendente</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL(PRIORVALUE({!$Record.Approval_Status__c}), &quot;Aguarda L1&quot;), &quot;N1&quot;, IF(ISPICKVAL(PRIORVALUE({!$Record.Approval_Status__c}), &quot;Aguarda L2&quot;), &quot;N2&quot;, IF(ISPICKVAL(PRIORVALUE({!$Record.Approval_Status__c}), &quot;Aguarda L3&quot;), &quot;N3&quot;, &quot;&quot;)))</expression>
    </formulas>
    <interviewLabel>SC Notif Recall InApp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SC - Notif Recall InApp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_CNT</name>
        <label>Get Custom Notification Type</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Nivel_Pendente</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Aprovacao_Pendente</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>DeveloperName</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_CNT</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>ISPICKVAL({!$Record.Approval_Status__c}, &quot;Recolhido&quot;)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varRecipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
