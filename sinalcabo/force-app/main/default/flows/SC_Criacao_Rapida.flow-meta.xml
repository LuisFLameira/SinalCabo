    <decisions>
        <name>Check_CP</name>
        <label>É Concurso Público?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Opp</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não é CP</defaultConnectorLabel>
        <rules>
            <name>outcome_ECP</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inp_ContratacaoPublica</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_CP</targetReference>
            </connector>
            <label>É CP</label>
        </rules>
    </decisions>
