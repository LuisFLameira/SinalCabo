        <rules>
            <name>outcome_FaltaTipo</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varOppNew.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varOppNew.Tipo_Negocio__c</leftValueReference>
