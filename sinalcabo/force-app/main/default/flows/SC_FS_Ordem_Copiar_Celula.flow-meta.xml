<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Quando a célula da ordem muda, copia tecnologia, território e coordenadas da célula e recalcula a divergência de território. O território da célula é a zona da NOS, que é um território filho, por isso a divergência mede-se ao nível do pai: a zona da célula pertence ao território do grupo que a NOS atribuiu? Serve a reclassificação feita à mão no registo; a criação pela API já preenche tudo em Apex.</description>
    <environments>Default</environments>
    <formulas>
        <name>fDivergencia</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT({!$Record.Classificacao_Confirmada__c}),
  NOT(ISBLANK({!Obter_a_celula.Territorio__c})),
  NOT(ISBLANK({!Obter_o_territorio_do_grupo.Id})),
  IF(
    ISBLANK({!Obter_a_celula.Territorio__r.ParentTerritoryId}),
    {!Obter_a_celula.Territorio__c} &amp; &quot;&quot;,
    {!Obter_a_celula.Territorio__r.ParentTerritoryId} &amp; &quot;&quot;
  ) &lt;&gt; ({!Obter_o_territorio_do_grupo.Id} &amp; &quot;&quot;)
)</expression>
    </formulas>
    <interviewLabel>SC FS Ordem copiar célula {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SC FS Ordem copiar célula</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Obter_a_celula</name>
        <label>Obter a célula escolhida</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Obter_o_territorio_do_grupo</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Celula__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Celula__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Obter_o_territorio_do_grupo</name>
        <label>Obter o território do grupo da NOS</label>
        <locationX>176</locationX>
        <locationY>296</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Copiar_da_celula_para_a_ordem</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Codigo_Grupo_Cliente__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Grupo_Cliente__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Codigo_Grupo_Cliente__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ServiceTerritory</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Copiar_da_celula_para_a_ordem</name>
        <label>Copiar da célula para a ordem</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Divergencia_Territorio__c</field>
            <value>
                <elementReference>fDivergencia</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Latitude</field>
            <value>
                <elementReference>Obter_a_celula.Localizacao__Latitude__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Longitude</field>
            <value>
                <elementReference>Obter_a_celula.Localizacao__Longitude__s</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ServiceTerritoryId</field>
            <value>
                <elementReference>Obter_a_celula.Territorio__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tecnologia__c</field>
            <value>
                <elementReference>Obter_a_celula.Tecnologia__c</elementReference>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Obter_a_celula</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Celula__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Celula__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>WorkOrder</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
